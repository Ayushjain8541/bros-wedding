# Restricted server-only application database role.
DATABASE_URL=
# Operator schema work only; never used by request handlers.
DATABASE_ADMIN_URL=
# Public project URL and publishable key (local test stack for tests).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only.
SUPABASE_SECRET_KEY=
# Exact application origin for mutation checks.
APP_ORIGIN=
# Random secret for durable rate-limit key HMACs.
RATE_LIMIT_HMAC_KEY=
# Operator only: 32 random bytes encoded as base64.
BACKUP_ENCRYPTION_KEY=
# Dedicated loopback database whose name includes test; never hosted credentials.
TEST_DATABASE_URL=
# Test reset/schema operator for the same dedicated loopback test database.
TEST_DATABASE_ADMIN_URL=
# Operator-only absolute path to private validated JSON, outside Git.
WEDDING_SEED_FILE=
# Independently reviewed private eventWindows/story/families/settings; required for operator canonical seeding.
WEDDING_SEED_EXPECTED_FILE=
# Storage namespaces are fixed by operator scripts: wedding-photos-dev / wedding-photos-test.
# Secure cookies remain mandatory outside explicit local HTTP development.
# Set true only with APP_ORIGIN=http://localhost or http://127.0.0.1.
ALLOW_INSECURE_LOCAL_COOKIES=
# Provisioning command only; supply privately for that one operator process.
ORGANIZER_EMAIL=
ORGANIZER_PASSWORD=
