# Restricted server-only application database role.
DATABASE_URL=
# Operator schema work only; never used by request handlers.
DATABASE_ADMIN_URL=
# Public project URL and publishable key (local test stack for tests).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only.
SUPABASE_SECRET_KEY=
# Exact application origin for mutation checks.
APP_ORIGIN=
# Random secret for durable rate-limit key HMACs.
RATE_LIMIT_HMAC_KEY=
# Operator only: 32 random bytes encoded as base64.
BACKUP_ENCRYPTION_KEY=
# Dedicated loopback database whose name includes test; never hosted credentials.
TEST_DATABASE_URL=
# Test reset/schema operator for the same dedicated loopback test database.
TEST_DATABASE_ADMIN_URL=
# Operator-only absolute path to private validated JSON, outside Git.
WEDDING_SEED_FILE=
# Independently reviewed private eventWindows/story/families/settings; required for operator canonical seeding.
WEDDING_SEED_EXPECTED_FILE=
# Storage namespaces are fixed by operator scripts: wedding-photos-dev / wedding-photos-test.
# Secure cookies remain mandatory outside explicit local HTTP development.
# Set true only with APP_ORIGIN=http://localhost or http://127.0.0.1.
ALLOW_INSECURE_LOCAL_COOKIES=
# Provisioning command only; supply privately for that one operator process.
ORGANIZER_EMAIL=
ORGANIZER_PASSWORD=

# Native PostgreSQL 17 operator binary directory; omit when pg_dump/pg_restore are on PATH.
PG_BIN_DIR=
# Runtime private bucket. wedding_test forcibly uses wedding-photos-test.
# Restore database wedding_restore_test_<suffix> requires wedding-photos-restore-test-<suffix>.
PHOTO_BUCKET=
# Test-only isolated Next output: .next-restore-test-<lowercase alphanumeric suffix>.
# Refused unless DATABASE_URL targets a matching-pattern loopback recovery test database.
NEXT_TEST_DIST_DIR=

# Backup source defaults to local. Hosted mode requires ALL the explicit fields below.
# These values are operator-only; never expose them to application/browser env.
BACKUP_SOURCE_MODE=
# Exact acknowledgment: I_APPROVE_THIS_HOSTED_BACKUP_SOURCE
BACKUP_HOSTED_SOURCE_ACK=
# Direct/session PostgreSQL URL, no query/fragment overrides; verified TLS is mandatory.
BACKUP_DATABASE_URL=
# Actual current_database() and current_user (may differ from pooler username).
BACKUP_EXPECTED_DATABASE=
BACKUP_EXPECTED_DATABASE_USER=
# Root HTTPS project URL, separate server secret, and exact existing private bucket ID.
BACKUP_SUPABASE_URL=
BACKUP_SUPABASE_SECRET_KEY=
BACKUP_PHOTO_BUCKET=
# Optional PEM trust bundles; otherwise standard platform trust. Verification cannot be disabled.
BACKUP_DATABASE_CA_FILE=
BACKUP_STORAGE_CA_FILE=
# Per Storage/dump operation and backend idle-in-transaction/statement bound: 1000..900000 ms.
# Default 120000 ms; backend timeout bounds the publication-lock interval during external work.
BACKUP_OPERATION_TIMEOUT_MS=
